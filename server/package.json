{
  "name": "@vinai/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:api": "node --env-file-if-exists=../.env dist/api/main.js",
    "start:ingest": "node --env-file-if-exists=../.env dist/ingest/main.js",
    "start:worker": "node --env-file-if-exists=../.env dist/worker/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "coap": "^1.6.0",
    "hono": "^4.13.13",
    "pg-boss": "^12.38.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
